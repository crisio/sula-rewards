# Copia este archivo a .dev.vars para correr la API en local (npm run dev).
AUTH_SECRET=cambia-esto-por-algo-largo-y-aleatorio-de-32+
EMAIL_MODE=log
# Opcional: cuenta para la revisión de la App Store (entra con este código fijo y no se le manda correo)
REVIEW_EMAIL=
REVIEW_CODE=
# Opcional: la llave .p8 de Sign in with Apple (para revocar al borrar la cuenta; ver docs/login.md)
APPLE_SIGNIN_KEY=
